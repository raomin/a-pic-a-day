# ==============================================================================
# A Pic a Day Bot Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values below

# ==============================================================================
# WhatsApp Group Configuration
# ==============================================================================

# The WhatsApp group ID to monitor (get this from bot logs after adding to group)
# Format: 120363423539891503@g.us
TARGET_GROUP_ID=

# ==============================================================================
# Database Configuration
# ==============================================================================

# Path to SQLite database file
DATABASE_PATH=./database.db

# ==============================================================================
# Bot Settings - Daily Picture Requirements
# ==============================================================================

# Daily deadline for picture submissions (24-hour format)
DAILY_DEADLINE_HOUR=23
DAILY_DEADLINE_MINUTE=59

# Reminder times (24-hour format) - Bot sends 3 reminders throughout the day
DAILY_REMINDER_HOUR=18      # First reminder (default: 6 PM)
DAILY_REMINDER_HOUR_2=20    # Second reminder (default: 8 PM)
DAILY_REMINDER_HOUR_3=22    # Final reminder (default: 10 PM)

# Timezone for scheduling (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: America/New_York, Europe/London, Asia/Tokyo, Australia/Sydney, Europe/Paris
TIMEZONE=Europe/Paris

# Grace period after deadline before removing users (in minutes)
GRACE_PERIOD_MINUTES=120

# ==============================================================================
# Message Control Settings
# ==============================================================================

# Send "Perfect Day" celebration message when everyone submits (true/false)
SEND_DAILY_SUMMARY_ON_PERFECT_DAY=true

# Send group reminder messages - set to false for quieter groups (true/false)
# Note: Individual DMs are always sent regardless of this setting
SEND_GROUP_REMINDERS=true

# ==============================================================================
# Admin Settings
# ==============================================================================

# Admin WhatsApp phone number for special commands (with country code, no + sign)
# Format: 1234567890 (optional - leave empty to disable admin commands)
BOT_ADMIN_PHONE=

# ==============================================================================
# Development & Debug Settings
# ==============================================================================

# Enable debug logging (true/false)
DEBUG=false

# Node environment (development/production)
NODE_ENV=production

# ==============================================================================
# Optional: Web Interface Settings (Future Feature)
# ==============================================================================

# Port for potential web dashboard (not currently implemented)
WEBHOOK_PORT=3000

# Webhook path for future web interface
WEBHOOK_PATH=/webhook

# ==============================================================================
# Example Complete Configuration
# ==============================================================================
#
# TARGET_GROUP_ID=120363423539891503@g.us
# DATABASE_PATH=./database.db
# DAILY_DEADLINE_HOUR=23
# DAILY_DEADLINE_MINUTE=59
# DAILY_REMINDER_HOUR=18
# DAILY_REMINDER_HOUR_2=20
# DAILY_REMINDER_HOUR_3=22
# TIMEZONE=Europe/Paris
# GRACE_PERIOD_MINUTES=120
# SEND_DAILY_SUMMARY_ON_PERFECT_DAY=true
# SEND_GROUP_REMINDERS=true
# BOT_ADMIN_PHONE=33612345678
# DEBUG=false
# NODE_ENV=production
# WEBHOOK_PORT=3000
# WEBHOOK_PATH=/webhook

# ==============================================================================
# Reminder Schedule Explanation
# ==============================================================================
#
# The bot sends 3 escalating reminder messages throughout the day:
#
# 1. FIRST REMINDER (DAILY_REMINDER_HOUR, default 6 PM):
#    - Gentle reminder that the daily picture hasn't been posted yet
#    - Friendly tone with time remaining until deadline
#
# 2. SECOND REMINDER (DAILY_REMINDER_HOUR_2, default 8 PM):
#    - More urgent reminder with less time remaining
#    - Emphasizes the automatic removal consequence
#
# 3. FINAL REMINDER (DAILY_REMINDER_HOUR_3, default 10 PM):
#    - Final warning before deadline
#    - Most urgent tone with very limited time remaining
#
# All times are in the timezone specified by TIMEZONE setting.
# Individual DMs are sent to users who haven't posted.
# Group reminder messages can be disabled with SEND_GROUP_REMINDERS=false.